# 실제 자격증명 — 절대 커밋 금지
config.json
*.bak
*.key
*.pem

# 파이썬 가상환경. requirements.txt 로 재생성한다 — 3,794개 파일을 버전관리할 이유가 없고,
# 플랫폼·파이썬 버전이 다르면 그대로 쓰지도 못한다.
.venv/
__pycache__/
*.pyc

# 벤치마크 데이터셋 — 이 저장소가 관리하지 않는다.
#
# 배포물이 아니다: prod 패키지는 src/ 와 sql/ 만 싣고(script/package.py 의 PAYLOAD_DIRS),
# 데몬은 세트를 DB 에서 읽는다. 파일이 저장소에 있든 없든 prod 는 달라지지 않는다.
#
# 지난 판본은 커밋 73ff7da 에 그대로 있으므로, 세트를 다시 만들어야 할 일이 생기면
# 거기서 생성기(generate_v2.py·templates_v2.py·templates.py·pools.py)를 꺼내면 된다.
dataset/

# v1 잔재. script/load_benchmark.py 는 이미 동작하지 않는다 — v2 스키마 이행에서 사라진
# store.replace() 를 부른다.
script/load_benchmark.py

# 편집기 스왑
*.swp

# 패키지 산출물 (./pretzel-ai package)
tmp/
